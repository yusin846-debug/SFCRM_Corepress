<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>CorePress Service Request List</masterLabel>
    <description>CorePress 고객 포털 서비스 요청 목록</description>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property name="homeUrl" type="String" label="홈 URL" default="portal-home" />
            <property name="assetListUrl" type="String" label="보유 설비 URL" default="asset-list" />
            <property name="serviceUrl" type="String" label="서비스 요청 등록 URL" default="service-request" />
            <property name="rfpUrl" type="String" label="RFP·RFQ URL" default="rfp-rfq" />
            <property name="quoteUrl" type="String" label="견적 URL" default="quotes" />
            <property name="detailUrl" type="String" label="서비스 요청 상세 경로" default="service-detail" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
