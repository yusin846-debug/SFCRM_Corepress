<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 480 360" role="img" aria-label="냉동식 에어드라이어">
  <defs>
    <linearGradient id="cab" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#f4f7f9"/>
      <stop offset="1" stop-color="#d7e0e6"/>
    </linearGradient>
  </defs>
  <rect width="480" height="360" fill="#eef2f5"/>
  <!-- inlet / outlet piping -->
  <g fill="none" stroke="#8fa3b0" stroke-width="10" stroke-linecap="round">
    <path d="M120 70 v-24 h60"/>
    <path d="M360 70 v-24 h-60"/>
  </g>
  <circle cx="180" cy="46" r="9" fill="#8fa3b0"/>
  <circle cx="300" cy="46" r="9" fill="#8fa3b0"/>
  <!-- cabinet -->
  <rect x="96" y="70" width="288" height="230" rx="10" fill="url(#cab)" stroke="#9aacb8" stroke-width="4"/>
  <!-- ventilation louvres -->
  <g stroke="#b6c4cd" stroke-width="6" stroke-linecap="round">
    <path d="M120 110 h150"/><path d="M120 130 h150"/><path d="M120 150 h150"/>
    <path d="M120 170 h150"/><path d="M120 190 h150"/>
  </g>
  <!-- control panel -->
  <rect x="292" y="104" width="72" height="96" rx="6" fill="#2f4a57"/>
  <circle cx="316" cy="132" r="10" fill="#3fb6ad"/>
  <rect x="304" y="156" width="48" height="10" rx="5" fill="#7f9aa6"/>
  <rect x="304" y="174" width="48" height="10" rx="5" fill="#7f9aa6"/>
  <!-- feet -->
  <rect x="120" y="300" width="26" height="24" fill="#9aacb8"/>
  <rect x="334" y="300" width="26" height="24" fill="#9aacb8"/>
  <text x="240" y="340" text-anchor="middle" font-family="Arial, sans-serif" font-size="20" fill="#6b7c88">냉동식 에어드라이어</text>
</svg>
